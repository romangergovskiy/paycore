# Copy to .env for `make run`. All variables are optional; the values below
# are the defaults. Unknown PAYCORE_* variables are rejected at startup.

# local | test | production
PAYCORE_ENV=local

PAYCORE_HTTP_ADDR=:8080
PAYCORE_HTTP_READ_HEADER_TIMEOUT=5s
PAYCORE_HTTP_READ_TIMEOUT=10s
# Must be greater than PAYCORE_HTTP_REQUEST_TIMEOUT.
PAYCORE_HTTP_WRITE_TIMEOUT=10s
PAYCORE_HTTP_IDLE_TIMEOUT=60s
# Deadline of every request context (docs/database/concurrency.md §10).
PAYCORE_HTTP_REQUEST_TIMEOUT=5s
PAYCORE_HTTP_MAX_BODY_BYTES=1048576

PAYCORE_SHUTDOWN_TIMEOUT=20s

# debug | info | warn | error
PAYCORE_LOG_LEVEL=info
# text | json; defaults to text for local and json otherwise.
# PAYCORE_LOG_FORMAT=text

# PostgreSQL. Empty PAYCORE_POSTGRES_DSN: the API starts without a pool (local unit tests).
# Application connects as paycore_app. Migrations run as paycore_owner. Bootstrap uses a superuser.
# PAYCORE_POSTGRES_DSN=postgres://paycore_app:change-me@127.0.0.1:5432/paycore?sslmode=disable
# PAYCORE_POSTGRES_MIGRATE_DSN=postgres://paycore_owner:change-me@127.0.0.1:5432/paycore?sslmode=disable
# PAYCORE_POSTGRES_ADMIN_DSN=postgres://postgres:change-me@127.0.0.1:5432/postgres?sslmode=disable
# PAYCORE_POSTGRES_READONLY_DSN=postgres://paycore_readonly:change-me@127.0.0.1:5432/paycore?sslmode=disable
# PAYCORE_POSTGRES_MAX_CONNS=10
# PAYCORE_POSTGRES_MIN_CONNS=1
# PAYCORE_POSTGRES_MAX_CONN_LIFETIME=30m
# PAYCORE_POSTGRES_MAX_CONN_IDLE_TIME=5m
# PAYCORE_POSTGRES_LOCK_TIMEOUT=3s
# PAYCORE_POSTGRES_STATEMENT_TIMEOUT=5s
